{
  "manifest_version": 3,
  "name": "JáTá — a conversa na aba de sempre",
  "version": "1.2.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "description": "Abre links wa.me e api.whatsapp.com na aba já aberta do WhatsApp Web, preservando número e mensagem.",
  "permissions": ["declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": [
    "*://wa.me/*",
    "*://api.whatsapp.com/*",
    "*://www.whatsapp.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "JáTá — abrir o WhatsApp Web",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "web_accessible_resources": [{
    "resources": ["handoff.html"],
    "matches": ["<all_urls>"]
  }],
  "minimum_chrome_version": "120"
}
