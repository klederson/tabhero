{
  "name": "tabhero",
  "version": "1.9.0",
  "license": "MIT",
  "author": "Klederson Bueno",
  "homepage": "https://klederson.github.io/tabhero/",
  "repository": {
    "type": "git",
    "url": "https://github.com/klederson/tabhero.git"
  },
  "private": true,
  "type": "module",
  "description": "New chat. Same tab. Open conversation links inside your already loaded WhatsApp Web tab.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:firefox": "node tests/firefox.mjs",
    "test:popup:firefox": "node tests/popup-firefox.mjs",
    "test:quick-reply": "node tests/quick-reply-browser.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node tests/site.mjs",
    "test:disclosures": "node tests/disclosures-browser.mjs",
    "build:store": "node scripts/build-store.mjs",
    "test:analytics": "node tests/website-analytics.mjs",
    "test:extension-analytics": "node tests/extension-analytics-browser.mjs",
    "test:extension-analytics:firefox": "node tests/extension-analytics-firefox.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "selenium-webdriver": "4.35.0"
  }
}
